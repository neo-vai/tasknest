generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  telegramChatId   String?   @map("telegram_chat_id")
  telegramLinkedAt DateTime? @map("telegram_linked_at")

  createdProjects          Project[]        @relation("ProjectOwner")
  assignedTasks            Task[]           @relation("TaskAssignee")
  createdTasks             Task[]           @relation("TaskAuthor")
  projectMemberships       ProjectMember[]
  notifications            Notification[]
  notificationPreferences  UserNotificationPreference[]
  telegramLinkCodes        TelegramLinkCode[]

  @@map("users")
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  ownerId     String   @map("owner_id")
  owner       User     @relation("ProjectOwner", fields: [ownerId], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tasks   Task[]           @relation("TaskProject")
  members ProjectMember[]

  @@map("projects")
}

model ProjectMember {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  role      String   @default("MEMBER")
  createdAt DateTime @default(now()) @map("created_at")

  @@id([userId, projectId])
  @@index([projectId])
  @@map("project_members")
}

model Task {
  id          String   @id @default(cuid())
  title       String
  description String?
  status      String   @default("TODO")
  projectId   String   @map("project_id")
  project     Project  @relation("TaskProject", fields: [projectId], references: [id], onDelete: Cascade)
  authorId    String?  @map("author_id")
  author      User?    @relation("TaskAuthor", fields: [authorId], references: [id])
  assigneeId  String?  @map("assignee_id")
  assignee    User?    @relation("TaskAssignee", fields: [assigneeId], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([projectId])
  @@map("tasks")
}

enum NotificationType {
  ADDED_TO_PROJECT
  REMOVED_FROM_PROJECT
  ROLE_CHANGED
  TASK_ASSIGNED
  TASK_UNASSIGNED
  TASK_COMPLETED
  TASK_REOPENED
  TASK_DELETED
  PROJECT_DELETED
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  metadata  Json?
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("notifications")
}

model UserNotificationPreference {
  id      String           @id @default(cuid())
  userId  String
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type    NotificationType
  enabled Boolean          @default(true)

  @@unique([userId, type])
  @@index([userId])
  @@map("user_notification_preferences")
}

model TelegramLinkCode {
  id        String   @id @default(cuid())
  code      String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("telegram_link_codes")
}